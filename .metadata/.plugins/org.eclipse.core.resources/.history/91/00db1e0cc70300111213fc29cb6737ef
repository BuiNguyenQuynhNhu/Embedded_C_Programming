#define RCC_APB2ENR   (*(volatile unsigned int*)0x40021018)
#define AFIO_MAPR     (*(volatile unsigned int*)0x40010004)

#define GPIOA_CRL     (*(volatile unsigned int*)0x40010800)
#define GPIOA_ODR     (*(volatile unsigned int*)0x4001080C)

#define GPIOB_CRL     (*(volatile unsigned int*)0x40010C00)
#define GPIOB_CRH     (*(volatile unsigned int*)0x40010C04)
#define GPIOB_ODR     (*(volatile unsigned int*)0x40010C0C)

void delay(volatile unsigned int t)
{
    while (t--);
}

int main(void)
{
    // Enable GPIOA, GPIOB, AFIO
    RCC_APB2ENR |= (1 << 0) | (1 << 2) | (1 << 3);

    // Disable JTAG, keep SWD (FREE PB13–PB15)
    AFIO_MAPR |= (1 << 25);

    // PA0–PA7 output push-pull 2MHz
    GPIOA_CRL = 0x22222222;

    // PB0, PB1 output
    GPIOB_CRL = 0x00000022;

    // PB10–PB15 output
    GPIOB_CRH = 0x22222200;

    // Kéo toàn bộ PB xuống LOW
    GPIOB_ODR &= ~(
        (1 << 0)  | (1 << 1)  |
        (1 << 10) | (1 << 11) |
        (1 << 12) | (1 << 13) |
        (1 << 14) | (1 << 15)
    );

    // Mảng map 8 hàng theo thứ tự PB bạn đang dùng
    const unsigned int row_pin[8] = {
        (1 << 0),   // PB0
        (1 << 1),   // PB1
        (1 << 10),  // PB10
        (1 << 11),  // PB11
        (1 << 12),  // PB12
        (1 << 13),  // PB13
        (1 << 14),  // PB14
        (1 << 15)   // PB15
    };

    while (1)
    {
        // Tắt tất cả hàng
        GPIOB_ODR |= (
            (1 << 0)  | (1 << 1)  |
            (1 << 10) | (1 << 11) |
            (1 << 12) | (1 << 13) |
            (1 << 14) | (1 << 15)
        );

        // Tắt tất cả cột
        GPIOA_ODR = 0x00;

        // ===== SÁNG TỪ DÒNG 1 → 8 =====
        for (int row = 0; row < 8; row++)
        {
            // Bật 1 cột duy nhất (PA0)
            GPIOA_ODR = (1 << 0);

            // Bật 1 hàng duy nhất
            GPIOB_ODR &= ~row_pin[row];

            // Giữ lâu để bạn nhìn
            delay(2000000);

            // Tắt hàng đó trước khi sang hàng tiếp
            GPIOB_ODR |= row_pin[row];
        }
    }


}
