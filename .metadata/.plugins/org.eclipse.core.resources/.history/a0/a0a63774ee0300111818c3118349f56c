#include "stm32f103xb.h"
#include <string.h>
#include <stdlib.h>

#define WIDTH  40
#define HEIGHT 20
#define SR_TXE    (1U << 7)

typedef struct { int x, y; } Point;

Point snake[100];
int snake_len = 3;
Point food;
char dir = 'r';

// --- 1. Sửa lỗi: Thêm hàm ghi 1 ký tự UART ---
void uart1_write(char ch) {
    while (!(USART1->SR & SR_TXE));
    USART1->DR = (ch & 0xFF);
}

void uart_write(const char *s) {
    while (*s) uart1_write(*s++);
}

void uart_init(void) {
    // Bật clock cho GPIOA và UART1
    RCC->APB2ENR |= (1 << 2) | (1 << 14);

    // Cấu hình PA9 (TX) là Alternate function push-pull (0xB)
    GPIOA->CRH &= ~(0xF << 4);
    GPIOA->CRH |=  (0xB << 4);

    // Cấu hình PA0, PA1, PA2, PA3 là Input Pull-up/down (0x8)
    GPIOA->CRL &= ~(0xFFFF);
    GPIOA->CRL |=   0x8888;
    GPIOA->ODR |=   0x000F; // Kéo lên mức cao (Pull-up)

    USART1->BRR = 0x1D4C; // Giả sử 72MHz -> 9600 baud. (Dùng 0x0341 nếu 8MHz)
    USART1->CR1 |= (1U << 13) | (1U << 3);
}

void draw() {
    // Lệnh ANSI để xóa màn hình và đưa con trỏ về góc trái trên
    uart_write("\033[2J\033[H");

    for (int y = 0; y < HEIGHT; y++) {
        for (int x = 0; x < WIDTH; x++) {
            if (y == 0 || y == HEIGHT - 1 || x == 0 || x == WIDTH - 1)
                uart1_write('#');
            else if (x == snake[0].x && y == snake[0].y)
                uart1_write('O'); // Đầu rắn
            else if (x == food.x && y == food.y)
                uart1_write('@'); // Thức ăn
            else {
                int isBody = 0;
                for (int i = 1; i < snake_len; i++) {
                    if (x == snake[i].x && y == snake[i].y) {
                        uart1_write('o'); // Thân rắn
                        isBody = 1; break;
                    }
                }
                if (!isBody) uart1_write(' ');
            }
        }
        uart_write("\r\n");
    }
}

void update() {
    // Di chuyển thân rắn
    for (int i = snake_len - 1; i > 0; i--) snake[i] = snake[i - 1];

    // Di chuyển đầu
    if (dir == 'u') snake[0].y--;
    if (dir == 'd') snake[0].y++;
    if (dir == 'l') snake[0].x--;
    if (dir == 'r') snake[0].x++;

    // Xuyên tường
    if (snake[0].x >= WIDTH - 1) snake[0].x = 1;
    else if (snake[0].x <= 0) snake[0].x = WIDTH - 2;
    if (snake[0].y >= HEIGHT - 1) snake[0].y = 1;
    else if (snake[0].y <= 0) snake[0].y = HEIGHT - 2;

    // Ăn mồi
    if (snake[0].x == food.x && snake[0].y == food.y) {
        if (snake_len < 100) snake_len++;
        food.x = (rand() % (WIDTH - 2)) + 1;
        food.y = (rand() % (HEIGHT - 2)) + 1;
    }
}

int main(void) {
    uart_init();

    // Khởi tạo vị trí ban đầu
    snake[0] = (Point){WIDTH/2, HEIGHT/2};
    snake[1] = (Point){WIDTH/2 - 1, HEIGHT/2};
    snake[2] = (Point){WIDTH/2 - 2, HEIGHT/2};
    food = (Point){10, 10};

    while (1) {
        // Đọc nút nhấn (Sử dụng logic Pull-up: Nhấn = 0)
        if (!(GPIOA->IDR & (1 << 0)) && dir != 'd') dir = 'u';
        if (!(GPIOA->IDR & (1 << 1)) && dir != 'u') dir = 'd';
        if (!(GPIOA->IDR & (1 << 2)) && dir != 'r') dir = 'l';
        if (!(GPIOA->IDR & (1 << 3)) && dir != 'l') dir = 'r';

        update();
        draw();

        // Delay để điều chỉnh tốc độ rắn
        for (volatile int i = 0; i < 500000; i++);
    }
}
