// ===== Register definitions =====
#define RCC_APB2ENR   (*(volatile unsigned int*)0x40021018)

#define GPIOA_CRL     (*(volatile unsigned int*)0x40010800)
#define GPIOA_ODR     (*(volatile unsigned int*)0x4001080C)

#define GPIOB_CRL     (*(volatile unsigned int*)0x40010C00)
#define GPIOB_CRH     (*(volatile unsigned int*)0x40010C04)
#define GPIOB_ODR     (*(volatile unsigned int*)0x40010C0C)

// ===== Simple delay =====
void delay(volatile unsigned int t)
{
    while (t--);
}

int main(void)
{
    // 1️⃣ Enable clock GPIOA, GPIOB
    RCC_APB2ENR |= (1 << 2) | (1 << 3);

    // 2️⃣ PA0–PA7: Output push-pull 2MHz
    GPIOA_CRL = 0x22222222;

    // 3️⃣ PB0, PB1 output
    GPIOB_CRL |= 0x00000022;

    // 4️⃣ PB10–PB15 output
    GPIOB_CRH |= 0x22222200;

    // 5️⃣ Kéo toàn bộ PB xuống LOW (GND)
    GPIOB_ODR &= ~(
        (1 << 0)  | (1 << 1)  |
        (1 << 10) | (1 << 11) |
        (1 << 12) | (1 << 13) |
        (1 << 14) | (1 << 15)
    );

    // 6️⃣ Test PA0 → PA7
    while (1)
    {
        for (int i = 0; i < 8; i++)
        {
            GPIOA_ODR &= ~0xFF;     // tắt PA0–PA7
            GPIOA_ODR |= (1 << i); // bật PAi
            delay(700000);
        }
    }
}
