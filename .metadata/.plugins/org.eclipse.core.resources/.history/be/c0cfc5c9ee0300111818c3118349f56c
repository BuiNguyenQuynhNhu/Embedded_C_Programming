#include "stm32f103xb.h"
#include <string.h>
#include <stdlib.h>
#include <stdio.h> // Thêm thư viện này để dùng sprintf

#define WIDTH  40
#define HEIGHT 20
#define SR_TXE    (1U << 7)

typedef struct { int x, y; } Point;

Point snake[100];
int snake_len = 3;
Point food;
char dir = 'r';
int score = 0; // Biến lưu điểm số

void uart1_write(char ch) {
    while (!(USART1->SR & SR_TXE));
    USART1->DR = (ch & 0xFF);
}

void uart_write(const char *s) {
    while (*s) uart1_write(*s++);
}

void uart_init(void) {
    RCC->APB2ENR |= (1 << 2) | (1 << 14);
    GPIOA->CRH &= ~(0xF << 4);
    GPIOA->CRH |=  (0xB << 4);
    GPIOA->CRL &= ~(0xFFFF);
    GPIOA->CRL |=   0x8888;
    GPIOA->ODR |=   0x000F;
    USART1->BRR = 0x0271; // 115200 baud @ 72MHz
    USART1->CR1 |= (1U << 13) | (1U << 3);
}

void draw() {
    char score_str[32];
    uart_write("\033[H"); // Đưa con trỏ về gốc

    // --- HIỂN THỊ ĐIỂM SỐ ---
    sprintf(score_str, " SCORE: %d    LENGTH: %d \r\n", score, snake_len);
    uart_write(score_str);

    for (int y = 0; y < HEIGHT; y++) {
        for (int x = 0; x < WIDTH; x++) {
            if (y == 0 || y == HEIGHT - 1 || x == 0 || x == WIDTH - 1)
                uart1_write('#');
            else if (x == snake[0].x && y == snake[0].y)
                uart1_write('O');
            else if (x == food.x && y == food.y)
                uart1_write('@');
            else {
                int isBody = 0;
                for (int i = 1; i < snake_len; i++) {
                    if (x == snake[i].x && y == snake[i].y) {
                        uart1_write('o');
                        isBody = 1; break;
                    }
                }
                if (!isBody) uart1_write(' ');
            }
        }
        uart_write("\r\n");
    }
}

void update() {
    Point nextHead = snake[0];
    if (dir == 'u') nextHead.y--;
    if (dir == 'd') nextHead.y++;
    if (dir == 'l') nextHead.x--;
    if (dir == 'r') nextHead.x++;

    // Game Over: Tự đâm vào thân
    for (int i = 0; i < snake_len; i++) {
        if (nextHead.x == snake[i].x && nextHead.y == snake[i].y) {
            score = 0;
            snake_len = 3;
            return;
        }
    }

    for (int i = snake_len - 1; i > 0; i--) snake[i] = snake[i - 1];
    snake[0] = nextHead;

    if (snake[0].x >= WIDTH - 1) snake[0].x = 1;
    else if (snake[0].x <= 0) snake[0].x = WIDTH - 2;
    if (snake[0].y >= HEIGHT - 1) snake[0].y = 1;
    else if (snake[0].y <= 0) snake[0].y = HEIGHT - 2;

    // Khi ăn mồi
    if (snake[0].x == food.x && snake[0].y == food.y) {
        score += 10; // Tăng 10 điểm mỗi lần ăn
        if (snake_len < 100) snake_len++;
        food.x = (rand() % (WIDTH - 2)) + 1;
        food.y = (rand() % (HEIGHT - 2)) + 1;
    }
}

int main(void) {
    uart_init();
    uart_write("\033[2J"); // Xóa toàn màn hình khi bắt đầu

    snake[0] = (Point){WIDTH/2, HEIGHT/2};
    snake[1] = (Point){WIDTH/2 - 1, HEIGHT/2};
    snake[2] = (Point){WIDTH/2 - 2, HEIGHT/2};
    food.x = 10; food.y = 10;

    while (1) {
        if (!(GPIOA->IDR & (1 << 0)) && dir != 'd') dir = 'u';
        else if (!(GPIOA->IDR & (1 << 1)) && dir != 'u') dir = 'd';
        else if (!(GPIOA->IDR & (1 << 2)) && dir != 'r') dir = 'l';
        else if (!(GPIOA->IDR & (1 << 3)) && dir != 'l') dir = 'r';

        update();
        draw();

        // Delay: Rắn chạy nhanh dần khi điểm cao (tùy chọn)
        int delay = 100000 - (score * 100);
        if (delay < 30000) delay = 30000;
        for (volatile int i = 0; i < delay; i++);
    }
}
