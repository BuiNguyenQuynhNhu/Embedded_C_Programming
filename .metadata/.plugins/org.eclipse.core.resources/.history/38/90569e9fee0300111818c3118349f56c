#include "stm32f103xb.h"
#include <string.h>
#include <stdlib.h>

#define WIDTH  40
#define HEIGHT 20
#define SR_TXE    (1U << 7)

typedef struct { int x, y; } Point;

Point snake[100];
int snake_len = 3;
Point food;
char dir = 'r';

void uart1_write(char ch) {
    while (!(USART1->SR & SR_TXE));
    USART1->DR = (ch & 0xFF);
}

void uart_write(const char *s) {
    while (*s) uart1_write(*s++);
}

void uart_init(void) {
    RCC->APB2ENR |= (1 << 2) | (1 << 14);

    // PA9 (TX) - Alternate Function Push-Pull
    GPIOA->CRH &= ~(0xF << 4);
    GPIOA->CRH |=  (0xB << 4);

    // PA0, 1, 2, 3 - Input Pull-up
    GPIOA->CRL &= ~(0xFFFF);
    GPIOA->CRL |=   0x8888;
    GPIOA->ODR |=   0x000F;

    // Cấu hình 115200 baud tại PCLK2 = 72MHz
    // UART DIV = 72,000,000 / (16 * 115200) = 39.0625
    // Mantissa = 39 (0x27), Fraction = 0.0625 * 16 = 1 (0x1)
    USART1->BRR = 0x0271;

    USART1->CR1 |= (1U << 13) | (1U << 3);
}

// Tối ưu hóa draw() để giảm nhấp nháy
void draw() {
    // Di chuyển con trỏ về (0,0) thay vì xóa toàn bộ màn hình để tránh giật
    uart_write("\033[H");

    for (int y = 0; y < HEIGHT; y++) {
        for (int x = 0; x < WIDTH; x++) {
            if (y == 0 || y == HEIGHT - 1 || x == 0 || x == WIDTH - 1)
                uart1_write('#');
            else if (x == snake[0].x && y == snake[0].y)
                uart1_write('O');
            else if (x == food.x && y == food.y)
                uart1_write('@');
            else {
                int isBody = 0;
                for (int i = 1; i < snake_len; i++) {
                    if (x == snake[i].x && y == snake[i].y) {
                        uart1_write('o');
                        isBody = 1; break;
                    }
                }
                if (!isBody) uart1_write(' ');
            }
        }
        uart_write("\r\n");
    }
}

// Thêm logic kiểm tra va chạm thân rắn (Game Over)
void update() {
    Point nextHead = snake[0];
    if (dir == 'u') nextHead.y--;
    if (dir == 'd') nextHead.y++;
    if (dir == 'l') nextHead.x--;
    if (dir == 'r') nextHead.x++;

    // Xử lý va chạm thân
    for (int i = 0; i < snake_len; i++) {
        if (nextHead.x == snake[i].x && nextHead.y == snake[i].y) {
            // Reset game nếu tự cắn mình
            snake_len = 3;
            return;
        }
    }

    for (int i = snake_len - 1; i > 0; i--) snake[i] = snake[i - 1];
    snake[0] = nextHead;

    // Xuyên tường
    if (snake[0].x >= WIDTH - 1) snake[0].x = 1;
    else if (snake[0].x <= 0) snake[0].x = WIDTH - 2;
    if (snake[0].y >= HEIGHT - 1) snake[0].y = 1;
    else if (snake[0].y <= 0) snake[0].y = HEIGHT - 2;

    if (snake[0].x == food.x && snake[0].y == food.y) {
        if (snake_len < 100) snake_len++;
        food.x = (rand() % (WIDTH - 2)) + 1;
        food.y = (rand() % (HEIGHT - 2)) + 1;
    }
}

int main(void) {
    uart_init();

    // Xóa màn hình một lần duy nhất lúc khởi động
    uart_write("\033[2J");

    snake[0] = (Point){WIDTH/2, HEIGHT/2};
    snake[1] = (Point){WIDTH/2 - 1, HEIGHT/2};
    snake[2] = (Point){WIDTH/2 - 2, HEIGHT/2};
    food = (Point){10, 10};

    while (1) {
        // Đọc phím có chống rung nhẹ bằng delay
        if (!(GPIOA->IDR & (1 << 0)) && dir != 'd') dir = 'u';
        else if (!(GPIOA->IDR & (1 << 1)) && dir != 'u') dir = 'd';
        else if (!(GPIOA->IDR & (1 << 2)) && dir != 'r') dir = 'l';
        else if (!(GPIOA->IDR & (1 << 3)) && dir != 'l') dir = 'r';

        update();
        draw();

        // Tăng tốc độ game lên một chút
        for (volatile int i = 0; i < 100000; i++);
    }
}
