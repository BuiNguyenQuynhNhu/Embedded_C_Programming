#include "stm32f103xb.h"
#include <stdlib.h>
#include <stdio.h>

#define WIDTH 40
#define HEIGHT 20
#define MAX_SNAKE_LEN 100

// --- Khai báo Struct thay cho Class ---
typedef struct {
    int X, Y;
} COORD;

typedef struct {
    COORD pos;
    COORD body[MAX_SNAKE_LEN];
    int len;
    char dir;
    int vel;
} Snake;

typedef struct {
    COORD pos;
} Food;

// --- Biến toàn cục ---
Snake snake;
Food food;
int score = 0;

// --- Khởi tạo UART & GPIO ---
void UART_Init() {
    RCC->APB2ENR |= (1 << 2) | (1 << 14); // Enable IOPA, USART1
    GPIOA->CRH &= ~(0xF << 4);
    GPIOA->CRH |= (0xB << 4); // PA9: Alternate Output Push-Pull
    USART1->BRR = 0x271;      // 115200 Baud (tăng lên để vẽ mượt hơn)
    USART1->CR1 |= (1 << 13) | (1 << 3); // UE, TE
}

void UART_SendChar(char c) {
    while (!(USART1->SR & (1 << 7)));
    USART1->DR = c;
}

void UART_SendString(char* s) {
    while (*s) UART_SendChar(*s++);
}

void GPIO_Init() {
    RCC->APB2ENR |= (1 << 2); // Clock Port A
    GPIOA->CRL &= ~(0xFFFF);  // Clear PA0-PA3
    GPIOA->CRL |= 0x8888;     // Input Pull-up/down
    GPIOA->ODR |= 0x0F;       // Pull-up PA0-PA3
}

// --- Logic Game (Chuyển từ Snake.cpp & Food.cpp) ---
void gen_food() {
    food.pos.X = (rand() % (WIDTH - 2)) + 1;
    food.pos.Y = (rand() % (HEIGHT - 2)) + 1;
}

void init_game() {
    snake.pos.X = WIDTH / 2;
    snake.pos.Y = HEIGHT / 2;
    snake.len = 1;
    snake.dir = 'r';
    snake.vel = 1;
    snake.body[0] = snake.pos;
    gen_food();
}

void move_snake() {
    // Lưu vị trí cũ
    COORD old_pos = snake.pos;

    switch(snake.dir) {
        case 'u': snake.pos.Y -= snake.vel; break;
        case 'd': snake.pos.Y += snake.vel; break;
        case 'l': snake.pos.X -= snake.vel; break;
        case 'r': snake.pos.X += snake.vel; break;
    }

    // Xuyên tường (Logic từ Snake.cpp của bạn)
    if (snake.pos.X < 0) snake.pos.X = WIDTH - 1;
    else if (snake.pos.X >= WIDTH) snake.pos.X = 0;
    if (snake.pos.Y < 0) snake.pos.Y = HEIGHT - 1;
    else if (snake.pos.Y >= HEIGHT) snake.pos.Y = 0;

    // Cập nhật thân rắn (Thay thế vector.push_back và erase)
    for (int i = snake.len - 1; i > 0; i--) {
        snake.body[i] = snake.body[i-1];
    }
    snake.body[0] = snake.pos;
}

// --- Hàm Board (Chuyển từ main.cpp) ---
void draw_board() {
    UART_SendString("\033[H"); // Đưa con trỏ về đầu (không xóa toàn màn hình để tránh nháy)
    char buffer[50];
    sprintf(buffer, "SCORE : %d \r\n", score);
    UART_SendString(buffer);

    for (int i = 0; i < HEIGHT; i++) {
        UART_SendString("\t\t#");
        for (int j = 0; j < WIDTH - 2; j++) {
            if (i == 0 || i == HEIGHT - 1) UART_SendChar('#');
            else if (i == snake.pos.Y && j + 1 == snake.pos.X) UART_SendChar('O');
            else if (i == food.pos.Y && j + 1 == food.pos.X) UART_SendChar('@');
            else {
                int isBody = 0;
                for (int k = 1; k < snake.len; k++) {
                    if (i == snake.body[k].Y && j + 1 == snake.body[k].X) {
                        UART_SendChar('o');
                        isBody = 1; break;
                    }
                }
                if (!isBody) UART_SendChar(' ');
            }
        }
        UART_SendString("#\r\n");
    }
}

int main(void) {
    UART_Init();
    GPIO_Init();
    init_game();

    while (1) {
        // Đọc nút bấm PA0-PA3
        if (!(GPIOA->IDR & (1 << 0)) && snake.dir != 'd') snake.dir = 'u';
        if (!(GPIOA->IDR & (1 << 1)) && snake.dir != 'u') snake.dir = 'd';
        if (!(GPIOA->IDR & (1 << 2)) && snake.dir != 'r') snake.dir = 'l';
        if (!(GPIOA->IDR & (1 << 3)) && snake.dir != 'l') snake.dir = 'r';

        move_snake();

        // Kiểm tra ăn mồi
        if (snake.pos.X == food.pos.X && snake.pos.Y == food.pos.Y) {
            if (snake.len < MAX_SNAKE_LEN) snake.len++;
            score += 10;
            gen_food();
        }

        // Kiểm tra va chạm (logic từ Snake::collided)
        for (int i = 1; i < snake.len; i++) {
            if (snake.pos.X == snake.body[i].X && snake.pos.Y == snake.body[i].Y) {
                UART_SendString("\r\n--- GAME OVER ---\r\n");
                while(1);
            }
        }

        draw_board();
        for (volatile int d = 0; d < 200000; d++); // Delay tốc độ game
    }
}
