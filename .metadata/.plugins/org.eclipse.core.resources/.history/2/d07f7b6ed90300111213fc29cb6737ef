#include "stm32f103xb.h"
#include <string.h>
#include <stdlib.h>

#define WIDTH  40
#define HEIGHT 20
#define GPIOAEN   (1U << 2)
#define UART1EN   (1U << 14)
#define SR_TXE    (1U << 7)

// Cấu trúc tọa độ
typedef struct { int x, y; } Point;

// Biến điều khiển game
Point snake[100];
int snake_len = 3;
Point food;
char dir = 'r'; // r: right, l: left, u: up, d: down
int score = 0;

void uart1_init(void) {
    RCC->APB2ENR |= GPIOAEN | UART1EN;
    GPIOA->CRH &= ~(0xFF << 4);
    GPIOA->CRH |=  (0xB << 4);  // PA9 TX

    // Cấu hình PA0-PA3 là Input Pull-up cho 4 nút bấm
    GPIOA->CRL &= ~(0xFFFF);
    GPIOA->CRL |= 0x8888;
    GPIOA->ODR |= 0x0F;

    USART1->BRR = 0x0341; // Baudrate 9600
    USART1->CR1 |= (1U << 13) | (1U << 3);
}

void uart1_write(int ch) {
    while (!(USART1->SR & SR_TXE)) {}
    USART1->DR = (ch & 0xFF);
}

void uart1_write_str(const char *s) {
    while (*s) uart1_write(*s++);
}

void draw_game() {
    uart1_write_str("\033[H"); // Đưa con trỏ về đầu màn hình
    for (int y = 0; y < HEIGHT; y++) {
        for (int x = 0; x < WIDTH; x++) {
            if (y == 0 || y == HEIGHT - 1 || x == 0 || x == WIDTH - 1) uart1_write('#');
            else if (x == snake[0].x && y == snake[0].y) uart1_write('O'); // Đầu rắn
            else if (x == food.x && y == food.y) uart1_write('@'); // Mồi
            else {
                int isBody = 0;
                for (int i = 1; i < snake_len; i++) {
                    if (x == snake[i].x && y == snake[i].y) {
                        uart1_write('o');
                        isBody = 1; break;
                    }
                }
                if (!isBody) uart1_write(' ');
            }
        }
        uart1_write_str("\r\n");
    }
}

void update_game() {
    // Di chuyển thân
    for (int i = snake_len - 1; i > 0; i--) snake[i] = snake[i - 1];

    // Di chuyển đầu theo hướng (Logic từ Snake.cpp)
    if (dir == 'u') snake[0].y--;
    if (dir == 'd') snake[0].y++;
    if (dir == 'l') snake[0].x--;
    if (dir == 'r') snake[0].x++;

    // Xuyên tường (Logic từ Snake.cpp)
    if (snake[0].x >= WIDTH - 1) snake[0].x = 1;
    else if (snake[0].x <= 0) snake[0].x = WIDTH - 2;
    if (snake[0].y >= HEIGHT - 1) snake[0].y = 1;
    else if (snake[0].y <= 0) snake[0].y = HEIGHT - 2;

    // Ăn mồi
    if (snake[0].x == food.x && snake[0].y == food.y) {
        snake_len++;
        food.x = (rand() % (WIDTH - 2)) + 1;
        food.y = (rand() % (HEIGHT - 2)) + 1;
    }
}

int main(void) {
    uart1_init();

    // Khởi tạo vị trí ban đầu
    snake[0] = (Point){WIDTH/2, HEIGHT/2};
    food = (Point){10, 10};

    while (1) {
            // Đọc nút bấm PA0-PA3: Thêm dấu '!' để nhận mức 0 (khi nhấn xuống G)
            if (!(GPIOA->IDR & (1 << 0)) && dir != 'd') dir = 'u'; // PA0: Up
            else if (!(GPIOA->IDR & (1 << 1)) && dir != 'u') dir = 'd'; // PA1: Down
            else if (!(GPIOA->IDR & (1 << 2)) && dir != 'r') dir = 'l'; // PA2: Left
            else if (!(GPIOA->IDR & (1 << 3)) && dir != 'l') dir = 'r'; // PA3: Right

            update_game();
            draw_game();

            for (volatile int i = 0; i < 200000; i++);
   }
}
