#define RCC_APB2ENR   (*(volatile unsigned int*)0x40021018)
#define AFIO_MAPR     (*(volatile unsigned int*)0x40010004)

#define GPIOA_CRL     (*(volatile unsigned int*)0x40010800)
#define GPIOA_ODR     (*(volatile unsigned int*)0x4001080C)

#define GPIOB_CRL     (*(volatile unsigned int*)0x40010C00)
#define GPIOB_CRH     (*(volatile unsigned int*)0x40010C04)
#define GPIOB_ODR     (*(volatile unsigned int*)0x40010C0C)

void delay(volatile unsigned int t)
{
    while (t--);
}

int main(void)
{
    // Enable GPIOA, GPIOB, AFIO
    RCC_APB2ENR |= (1 << 0) | (1 << 2) | (1 << 3);

    // Disable JTAG, keep SWD (FREE PB13–PB15)
    AFIO_MAPR |= (1 << 25);

    // PA0–PA7 output push-pull 2MHz
    GPIOA_CRL = 0x22222222;

    // PB0, PB1 output
    GPIOB_CRL = 0x00000022;

    // PB10–PB15 output
    GPIOB_CRH = 0x22222200;

    // Kéo toàn bộ PB xuống LOW
    GPIOB_ODR &= ~(
        (1 << 0)  | (1 << 1)  |
        (1 << 10) | (1 << 11) |
        (1 << 12) | (1 << 13) |
        (1 << 14) | (1 << 15)
    );

    // Mảng map 8 hàng theo thứ tự PB bạn đang dùng
    const unsigned int row_pin[8] = {
        (1 << 0),   // PB0
        (1 << 1),   // PB1
        (1 << 10),  // PB10
        (1 << 11),  // PB11
        (1 << 12),  // PB12
        (1 << 13),  // PB13
        (1 << 14),  // PB14
        (1 << 15)   // PB15
    };

    while (1)
    {
        // Bật tất cả cột (PA)
        GPIOA_ODR = 0xFF;

        // Tắt toàn bộ hàng (PB)
        GPIOB_ODR |= (
            (1 << 0)  | (1 << 1)  |
            (1 << 10) | (1 << 11) |
            (1 << 12) | (1 << 13) |
            (1 << 14) | (1 << 15)
        );

        // ====== TEST TỪNG CHÂN ======

        GPIOB_ODR &= ~(1 << 0);   // PB0
        delay(1500000);

        GPIOB_ODR |=  (1 << 0);
        GPIOB_ODR &= ~(1 << 1);   // PB1
        delay(1500000);

        GPIOB_ODR |=  (1 << 1);
        GPIOB_ODR &= ~(1 << 10);  // PB10
        delay(1500000);

        GPIOB_ODR |=  (1 << 10);
        GPIOB_ODR &= ~(1 << 11);  // PB11
        delay(1500000);

        GPIOB_ODR |=  (1 << 11);
        GPIOB_ODR &= ~(1 << 12);  // PB12
        delay(1500000);

        GPIOB_ODR |=  (1 << 12);
        GPIOB_ODR &= ~(1 << 13);  // PB13
        delay(1500000);

        GPIOB_ODR |=  (1 << 13);
        GPIOB_ODR &= ~(1 << 14);  // PB14
        delay(1500000);

        GPIOB_ODR |=  (1 << 14);
        GPIOB_ODR &= ~(1 << 15);  // PB15
        delay(1500000);

        GPIOB_ODR |=  (1 << 15);
    }

}
