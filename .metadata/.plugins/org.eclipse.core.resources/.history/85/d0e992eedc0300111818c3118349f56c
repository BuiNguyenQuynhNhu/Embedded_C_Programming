#include "stm32f103xb.h"
#include <stdio.h>
#include <stdlib.h>

#define SR_TXE (1U << 7)

char keys[4][4] = {
    {'1', '2', '3', '+'},
    {'4', '5', '6', '-'},
    {'7', '8', '9', '*'},
    {'0', '/', '%', '='}
};

void uart1_init(void) {
    RCC->APB2ENR |= (1 << 2) | (1 << 14);
    GPIOA->CRH &= ~(0xF << 4);
    GPIOA->CRH |= (0xB << 4);
    USART1->BRR = 0x0341;
    USART1->CR1 |= (1 << 13) | (1 << 3);
}

void uart1_write(int ch) {
    while (!(USART1->SR & SR_TXE));
    USART1->DR = (ch & 0xFF);
}

void uart1_write_str(const char *s) {
    while (*s) uart1_write(*s++);
}

void keypad_init(void) {
    GPIOA->CRL &= ~(0xFFFFFFFF);
    GPIOA->CRL |= 0x88883333;
    GPIOA->ODR |= 0xF0;
}

char keypad_scan(void) {
    for (int r = 0; r < 4; r++) {
        GPIOA->ODR |= 0x0F;
        GPIOA->ODR &= ~(1 << r);

        for (int c = 0; c < 4; c++) {
            if (!(GPIOA->IDR & (1 << (c + 4)))) {
                while (!(GPIOA->IDR & (1 << (c + 4))));
                return keys[r][c];
            }
        }
    }
    return 0;
}

int main(void) {
    uart1_init();
    keypad_init();

    char input[16];
    int idx = 0;
    int val1 = 0, val2 = 0;
    char op = 0;

    uart1_write_str("Simple Calculator Ready!\r\n");

    while (1) {
        char key = keypad_scan();
        if (key) {
            uart1_write(key);

            if (key >= '0' && key <= '9') {
                input[idx++] = key;
            } else if (key == '=') {
                input[idx] = '\0';
                val2 = atoi(input);
                int res = 0;
                if (op == '+') res = val1 + val2;
                if (op == '-') res = val1 - val2;
                if (op == '*') res = val1 * val2;
                if (op == '/') res = (val2 != 0) ? val1 / val2 : 0;
                if (op == '%') res = (val2 != 0) ? val1 % val2 : 0;

                char buf[32];
                sprintf(buf, "\r\nResult: %d\r\n", res);
                uart1_write_str(buf);
                idx = 0;
            } else {
                input[idx] = '\0';
                val1 = atoi(input);
                op = key;
                idx = 0;
            }
        }
        for (volatile int i = 0; i < 50000; i++);
    }
}
