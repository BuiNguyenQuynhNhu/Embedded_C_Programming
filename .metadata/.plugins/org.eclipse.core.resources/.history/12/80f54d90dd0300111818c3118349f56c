#include "stm32f103xb.h"
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define SR_TXE (1U << 7)

// Layout bàn phím 4x4 theo yêu cầu
char keys[4][4] = {
    {'1', '2', '3', '+'},
    {'4', '5', '6', '-'},
    {'7', '8', '9', '*'},
    {'0', '/', '%', '='}
};

// Biến toàn cục cho máy tính
int current_result = 0;
char last_op = 0;
char input_buffer[16] = {0};
int idx = 0;
int is_first_input = 1;

// --- Hàm khởi tạo UART1 (9600 baud) ---
void uart1_init(void) {
    RCC->APB2ENR |= (1 << 2) | (1 << 14); // Bật Clock Port A và UART1
    GPIOA->CRH &= ~(0xF << 4);
    GPIOA->CRH |= (0xB << 4);  // PA9 là TX
    USART1->BRR = 0x0341;      // 9600 Baud cho xung 8MHz
    USART1->CR1 |= (1 << 13) | (1 << 3); // Bật UART và Bộ truyền
}

void uart1_write_str(const char *s) {
    while (*s) {
        while (!(USART1->SR & SR_TXE));
        USART1->DR = (*s++ & 0xFF);
    }
}

// --- Hàm khởi tạo Bàn phím (PA0 - PA7) ---
void keypad_init(void) {
    // PA0-PA3: Output Push-pull (Hàng), PA4-PA7: Input Pull-up (Cột)
    GPIOA->CRL &= ~(0xFFFFFFFF);
    GPIOA->CRL |= 0x88883333;    // Cấu hình thanh ghi CRL cho Port A
    GPIOA->ODR |= 0xF0;          // Kích hoạt điện trở kéo lên cho các chân Input (PA4-PA7)
}

// --- Hàm quét bàn phím ma trận ---
char keypad_scan(void) {
    for (int r = 0; r < 4; r++) {
        GPIOA->ODR |= 0x0F;      // Kéo tất cả 4 hàng lên 1
        GPIOA->ODR &= ~(1 << r); // Kéo duy nhất hàng hiện tại xuống 0

        for (int c = 0; c < 4; c++) {
            if (!(GPIOA->IDR & (1 << (c + 4)))) { // Nếu cột c đọc được mức 0
                for(volatile int d = 0; d < 50000; d++); // Chống dội đơn giản
                while (!(GPIOA->IDR & (1 << (c + 4))));  // Chờ cho đến khi nhả nút
                return keys[r][c];
            }
        }
    }
    return 0;
}

// --- Hàm tính toán ---
int calculate(int v1, int v2, char op) {
    switch(op) {
        case '+': return v1 + v2;
        case '-': return v1 - v2;
        case '*': return v1 * v2;
        case '/': return (v2 != 0) ? v1 / v2 : 0;
        case '%': return (v2 != 0) ? v1 % v2 : 0; // Phép chia lấy dư
        default: return v2;
    }
}

int main(void) {
    uart1_init();
    keypad_init();

    uart1_write_str("\r\n--- STM32 Multi-step Calculator ---\r\n");

    while (1) {
        char key = keypad_scan();
        if (key) {
            // Echo ký tự lên UART để theo dõi
            char echo[2] = {key, '\0'};
            uart1_write_str(echo);

            if (key >= '0' && key <= '9') {
                if (idx < 15) input_buffer[idx++] = key;
            }
            else {
                input_buffer[idx] = '\0';
                int current_val = atoi(input_buffer);
                idx = 0;

                if (is_first_input) {
                    current_result = current_val;
                    is_first_input = 0;
                } else {
                    current_result = calculate(current_result, current_val, last_op);
                }

                if (key == '=') {
                    char res_str[40];
                    sprintf(res_str, "\r\nResult: %d\r\n", current_result);
                    uart1_write_str(res_str);
                    is_first_input = 1; // Reset để bắt đầu phép tính mới
                    last_op = 0;
                } else {
                    last_op = key; // Lưu toán tử hiện tại (+, -, *, /, %)
                }
                memset(input_buffer, 0, 16);
            }
        }
    }
}
