#include "stm32f103xb.h"
#include <string.h>
#include <stdlib.h>

#define WIDTH  40
#define HEIGHT 20
#define GPIOAEN   (1U << 2)
#define UART1EN   (1U << 14)
#define SR_TXE    (1U << 7)

typedef struct { int x, y; } Point;

Point snake[100];
int snake_len = 3;
Point food;
char dir = 'r';
int score = 0;

void uart_init(void) {
    RCC->APB2ENR |= GPIOAEN | UART1EN;
    GPIOA->CRH &= ~(0xFF << 4);
    GPIOA->CRH |=  (0xB << 4);
    GPIOA->CRL &= ~(0xFFFF);
    GPIOA->CRL |= 0x8888;
    GPIOA->ODR |= 0x0F;

    USART1->BRR = 0x0341;
    USART1->CR1 |= (1U << 13) | (1U << 3);
}


void uart_write(const char *s) {
    while (*s) uart1_write(*s++);
}

void draw() {
    uart_write("\033[H");
    for (int y = 0; y < HEIGHT; y++) {
        for (int x = 0; x < WIDTH; x++) {
            if (y == 0 || y == HEIGHT - 1 || x == 0 || x == WIDTH - 1) uart1_write('#');
            else if (x == snake[0].x && y == snake[0].y) uart1_write('O');
            else if (x == food.x && y == food.y) uart1_write('@');
            else {
                int isBody = 0;
                for (int i = 1; i < snake_len; i++) {
                    if (x == snake[i].x && y == snake[i].y) {
                        uart1_write('o');
                        isBody = 1; break;
                    }
                }
                if (!isBody) uart1_write(' ');
            }
        }
        uart_write("\r\n");
    }
}

void update() {
    for (int i = snake_len - 1; i > 0; i--) snake[i] = snake[i - 1];

    if (dir == 'u') snake[0].y--;
    if (dir == 'd') snake[0].y++;
    if (dir == 'l') snake[0].x--;
    if (dir == 'r') snake[0].x++;

    if (snake[0].x >= WIDTH - 1) snake[0].x = 1;
    else if (snake[0].x <= 0) snake[0].x = WIDTH - 2;
    if (snake[0].y >= HEIGHT - 1) snake[0].y = 1;
    else if (snake[0].y <= 0) snake[0].y = HEIGHT - 2;

    if (snake[0].x == food.x && snake[0].y == food.y) {
        snake_len++;
        food.x = (rand() % (WIDTH - 2)) + 1;
        food.y = (rand() % (HEIGHT - 2)) + 1;
    }
}

int main(void) {
    uart_init();
    snake[0] = (Point){WIDTH/2, HEIGHT/2};
    food = (Point){10, 10};

    while (1) {
            if (!(GPIOA->IDR & (1 << 0)) && dir != 'd') dir = 'u';
            else if (!(GPIOA->IDR & (1 << 1)) && dir != 'u') dir = 'd';
            else if (!(GPIOA->IDR & (1 << 2)) && dir != 'r') dir = 'l';
            else if (!(GPIOA->IDR & (1 << 3)) && dir != 'l') dir = 'r';

            update();
            draw();

            for (volatile int i = 0; i < 200000; i++);
   }
}
